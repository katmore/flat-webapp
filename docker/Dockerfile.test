# Test runner for the functional tests (tests/). For local development only. PHPUnit runs in
# PHP 7.4 and sends real HTTP requests to the application's web container (docker/compose.test.yml).
FROM composer:2.11@sha256:0049ce90b432795bf413a738b073963ada1a689e1a8708104684baafe94586ec AS dependencies
ARG COMPOSER_PREFER_INSTALL=dist
ARG GITHUB_ARCHIVE_CACHE=0
WORKDIR /opt/flat-webapp-tests
COPY tests/docker/composer.json tests/docker/composer.lock ./
COPY tests/docker/github-archives.php /usr/local/bin/github-archives.php
RUN --mount=type=secret,id=proxy_ca \
    set -eu; task_ca=/etc/ssl/certs/ca-certificates.crt; \
    if [ -f /run/secrets/proxy_ca ]; then task_ca=/run/secrets/proxy_ca; fi; \
    export COMPOSER_CAFILE="$task_ca" GIT_SSL_CAINFO="$task_ca"; \
    if [ "$GITHUB_ARCHIVE_CACHE" = 1 ]; then \
        task_cache_dir=$(composer config cache-files-dir --absolute); \
        php /usr/local/bin/github-archives.php composer.lock "$task_cache_dir"; \
    fi; \
    composer install --no-interaction --no-progress --prefer-install="$COMPOSER_PREFER_INSTALL" --no-plugins --no-scripts && \
    find vendor -type d -name .git -prune -exec rm -rf {} +

FROM php:7.4-cli@sha256:620a6b9f4d4feef2210026172570465e9d0c1de79766418d3affd09190a7fda5
# Report everything, always: PHP's own development configuration (error_reporting = E_ALL).
RUN cp /usr/local/etc/php/php.ini-development /usr/local/etc/php/php.ini
COPY --from=dependencies /opt/flat-webapp-tests /opt/flat-webapp-tests
RUN chmod -R a+rX /opt/flat-webapp-tests
RUN php -r 'if (PHP_VERSION !== "7.4.33") { throw new RuntimeException("Unexpected PHP version"); } if (error_reporting() !== E_ALL) { throw new RuntimeException("error_reporting is not E_ALL"); } if (!extension_loaded("curl")) { throw new RuntimeException("Missing extension: curl"); } require "/opt/flat-webapp-tests/vendor/autoload.php"; echo "Verified PHP ".PHP_VERSION." and PHPUnit\n";'
WORKDIR /app
ENTRYPOINT ["php", "/opt/flat-webapp-tests/vendor/bin/phpunit"]
