# Test runner for the functional tests (tests/). For local development only. PHPUnit runs in
# PHP 7.3 and sends real HTTP requests to the application's web container (docker/compose.test.yml).
FROM composer:2.2@sha256:4c156e03ca848b69528dde30996d8922b47a9946e76d5cc563cf7f0898e8aa86 AS dependencies
ARG COMPOSER_PREFER_INSTALL=dist
WORKDIR /opt/flat-webapp-tests
COPY tests/docker/composer.json tests/docker/composer.lock ./
RUN --mount=type=secret,id=proxy_ca \
    task_ca=/etc/ssl/certs/ca-certificates.crt; \
    if [ -f /run/secrets/proxy_ca ]; then task_ca=/run/secrets/proxy_ca; fi; \
    export COMPOSER_CAFILE="$task_ca" GIT_SSL_CAINFO="$task_ca"; \
    composer install --no-interaction --no-progress --prefer-install="$COMPOSER_PREFER_INSTALL" --no-plugins --no-scripts

FROM php:7.3-cli@sha256:bd6f2dc7a4e4537e927355c94a74c3022911aa504278f5f0fd94016c90dfaecc
# Report everything, always: PHP's own development configuration (error_reporting = E_ALL).
RUN cp /usr/local/etc/php/php.ini-development /usr/local/etc/php/php.ini
COPY --from=dependencies /opt/flat-webapp-tests /opt/flat-webapp-tests
RUN chmod -R a+rX /opt/flat-webapp-tests
RUN php -r 'if (PHP_VERSION !== "7.3.33") { throw new RuntimeException("Unexpected PHP version"); } if (error_reporting() !== E_ALL) { throw new RuntimeException("error_reporting is not E_ALL"); } if (!extension_loaded("curl")) { throw new RuntimeException("Missing extension: curl"); } require "/opt/flat-webapp-tests/vendor/autoload.php"; echo "Verified PHP ".PHP_VERSION." and PHPUnit\n";'
WORKDIR /app
ENTRYPOINT ["php", "/opt/flat-webapp-tests/vendor/bin/phpunit"]
