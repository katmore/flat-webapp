#!/bin/sh
# Functional tests: starts the application in Docker (Apache and PHP, as docker/bin/serve does)
# and runs PHPUnit against it with real HTTP requests. For local development only.
# Arguments go to PHPUnit (for example --filter ApiTest). The run fails when a test fails or when
# the server log contains a PHP warning, notice, deprecation or fatal error.
set -eu
repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$repo_dir"

case "${1:-}" in
    -h|--help)
        echo 'Usage: docker/bin/test [PHPUnit arguments]'
        echo '  Set WEBAPP_CA_FILE to a CA bundle file if downloads need an extra CA.'
        echo '  Set WEBAPP_GITHUB_ARCHIVES=1 to cache locked test-tool archives from codeload.github.com.'
        exit 0 ;;
esac

# Dependencies are installed as the current user so the files stay yours.
# Set WEBAPP_UID and WEBAPP_GID to override (for example when running as root).
export WEBAPP_UID=${WEBAPP_UID:-$(id -u)} WEBAPP_GID=${WEBAPP_GID:-$(id -g)}
if [ "$WEBAPP_UID" = 0 ]; then export WEBAPP_UID=1000 WEBAPP_GID=1000; fi
dev="-f docker/compose.yml"; test_files="-f docker/compose.test.yml"
if [ -n "${WEBAPP_CA_FILE:-}" ]; then
    dev="$dev -f docker/compose.ca.yml"
    test_files="$test_files -f docker/compose.test.ca.yml"
fi
compose() { docker compose $test_files "$@"; }

# Reconcile existing installs with the tracked lock too; an old vendor tree must
# not silently select a different framework or dependency version.
echo '== installing locked PHP dependencies (Composer)'
docker compose $dev --profile tools run --rm composer install --no-interaction --no-progress \
    --prefer-install="${COMPOSER_PREFER_INSTALL:-dist}" --ignore-platform-req=ext-mongodb

log=$(mktemp)
cleanup() {
    status=$?
    trap - EXIT INT TERM
    rm -f "$log"
    compose down --volumes --remove-orphans >/dev/null 2>&1 || status=1
    exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

compose build web tests
compose up -d --wait web
set +e
compose run --rm --no-deps tests "$@"
status=$?
set -e

# Every PHP message in the server log is a failure, even when all tests passed.
compose logs --no-color web > "$log" 2>&1
if ! compose run --rm -T --no-deps -v "$log:/server.log:ro" --entrypoint php tests tests/tools/check-server-log.php /server.log; then
    echo 'The server log check failed: fix the reported errors.' >&2
    status=1
fi
exit "$status"
