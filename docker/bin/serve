#!/bin/sh
# Starts the web application in Docker: installs dependencies when missing,
# then serves it with Apache and PHP 7.2.
set -eu
repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$repo_dir"

usage() {
    echo 'Usage: docker/bin/serve [--port N] [--flat DIR] [--install] [--production] [--detach]'
    echo '       docker/bin/serve --stop'
    echo '  --port N     host port (default 8080, or WEBAPP_PORT)'
    echo '  --flat DIR   serve flat from a local checkout (for example ../flat)'
    echo '               instead of the copy Composer installed'
    echo '  --install    run Composer again even if already installed'
    echo '  --production use the production PHP settings: errors are hidden from visitors'
    echo '               (default: development settings, errors are shown)'
    echo '  --detach     start the server in the background and return (default: stay in'
    echo '               the foreground, streaming the server log; Ctrl-C stops it)'
    echo '  --stop       stop and remove the web container'
    echo 'Set WEBAPP_CA_FILE to a CA bundle file if downloads need an extra CA.'
}

port=${WEBAPP_PORT:-8080}; flat_dir=; install=false; stop=false; detach=false; php_ini=development
while [ $# -gt 0 ]; do
    case $1 in
        --port) port=$2; shift 2 ;;
        --flat) flat_dir=$(CDPATH= cd -- "$2" && pwd); shift 2 ;;
        --install) install=true; shift ;;
        --production) php_ini=production; shift ;;
        --detach) detach=true; shift ;;
        --stop) stop=true; shift ;;
        -h|--help) usage; exit 0 ;;
        *) usage >&2; exit 2 ;;
    esac
done

# Dependencies are installed as the current user so the files stay yours.
# Set WEBAPP_UID and WEBAPP_GID to override (for example when running as root).
export WEBAPP_PHP_INI=$php_ini WEBAPP_PORT=$port WEBAPP_UID=${WEBAPP_UID:-$(id -u)} WEBAPP_GID=${WEBAPP_GID:-$(id -g)}
files="-f docker/compose.yml"
if [ -n "${WEBAPP_CA_FILE:-}" ]; then files="$files -f docker/compose.ca.yml"; fi
if [ -n "$flat_dir" ]; then export WEBAPP_FLAT_DIR=$flat_dir; files="$files -f docker/compose.flat.yml"; fi
compose() { docker compose $files "$@"; }

if [ "$stop" = true ]; then compose down; exit 0; fi

if [ "$install" = true ] || [ ! -f vendor/autoload.php ]; then
    echo '== installing PHP dependencies (Composer)'
    # ext-mongodb is only needed by flat's optional MongoDB code; the web image has none.
    compose --profile tools run --rm composer install --no-interaction --no-progress \
        --ignore-platform-req=ext-mongodb
fi
urls() {
    echo "flat-webapp ($php_ini PHP settings):"
    echo "  http://localhost:$port/view.php/home"
    echo "  http://localhost:$port/api.php/example"
}
if [ "$detach" = true ]; then
    # --wait returns once the health check (a request for the home view) succeeds
    compose up -d --build --wait web
    echo; urls
    echo "Stop it with: docker/bin/serve --stop"
else
    echo; urls
    echo "The server log streams below: every request and every PHP error, as it happens."
    echo ">>> Press Ctrl-C to stop the server and remove its container. <<<"
    echo
    # Attached: Apache's access log and every PHP error appear here as they happen.
    compose up --build web || true
    echo
    echo "Stopping flat-webapp..."
    compose down >/dev/null 2>&1 || true
    echo "Stopped."
fi
